{
  "port": 8000,
  "bindIp": "0.0.0.0",
  "idleTimeout": 180000,
  "rootGitDirectory": "/var/lib/git-bridge",
  "allowedCorsOrigins": "http://localhost",
  "apiBaseUrl": "http://overleaf:4001/api/v0",
  "postbackBaseUrl": "http://git-bridge:8000",
  "serviceName": "OverLeaf@ZJUSCT",
  "oauth2Server": "http://overleaf:4001",
  "userPasswordEnabled": false,
  "repoStore": { "maxFileNum": 2000, "maxFileSize": 50000001 },
  "swapStore": { "type": "noop" },
  "swapJob": {
    "minProjects": 50,
    "lowGiB": 128,
    "highGiB": 256,
    "intervalMillis": 3600000,
    "compressionMethod": "gzip"
  }
}
