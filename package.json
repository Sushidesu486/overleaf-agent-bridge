{
  "name": "overleaf-agent-bridge",
  "version": "0.4.0",
  "description": "Personal MCP access and native agent collaboration for self-hosted Overleaf",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "diagnose": "tsx src/cli.ts",
    "mcp": "tsx src/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "lab:bootstrap": "node scripts/bootstrap.mjs && tsx scripts/create-project.ts",
    "lab:init": "node scripts/init-lab.mjs",
    "build:extension": "esbuild src/agent/http.ts --bundle --platform=node --format=cjs --target=node20 --outfile=extensions/agent-access/mcp.cjs",
    "smoke:connection": "tsx scripts/smoke-connection.ts",
    "smoke:compile": "tsx scripts/smoke-compile.ts",
    "smoke:personal": "tsx scripts/smoke-personal.ts",
    "connect": "tsx src/connector/cli.ts",
    "build:connector": "esbuild src/connector/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=extensions/agent-access/public/overleaf-agent-connector.mjs"
  },
  "keywords": [
    "overleaf",
    "latex",
    "mcp",
    "acp",
    "agents"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cheerio": "1.2.0",
    "tough-cookie": "6.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  }
}
