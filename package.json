{
  "name": "overleaf-agent",
  "version": "0.2.0",
  "description": "Independent MCP adapter for self-hosted Overleaf",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "diagnose": "tsx src/cli.ts",
    "mcp": "tsx src/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "lab:bootstrap": "node scripts/bootstrap.mjs && tsx scripts/create-project.ts",
    "lab:init": "node scripts/init-lab.mjs",
    "build:extension": "esbuild src/agent/http.ts --bundle --platform=node --format=cjs --target=node20 --outfile=extensions/agent-access/mcp.cjs",
    "smoke:personal": "tsx scripts/smoke-personal.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cheerio": "1.2.0",
    "tough-cookie": "6.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  }
}
